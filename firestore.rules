rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 匿名ログイン(Firebase Auth)を通った端末だけが読み書きできる。
    // これで検索エンジンや無関係な第三者のアクセスは弾ける。
    // ただしアプリのURLを知っていれば誰でも匿名ログインできるため、
    // 「URLをチーム外に共有しない」ことは引き続き前提。
    // App Check を併用すると、このアプリのページ以外からの読み書きも弾ける。
    function ok() { return request.auth != null; }

    match /team/{doc} { allow read, write: if ok(); }
    match /att/{eid}  { allow read, write: if ok(); }

    // 上記以外のパスは一切許可しない
    match /{document=**} { allow read, write: if false; }
  }
}
